// Version information shown in the DLL's properties (Explorer > Properties > Details). Antivirus
// heuristics rate a DLL with no publisher, product or description at all as more suspicious.
#include <winver.h>

#define KC_VER 0,3,3,0
#define KC_VER_STR "0.3.3"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION KC_VER
 PRODUCTVERSION KC_VER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName", "LRaverdy (KenshiCoop, open source)"
            VALUE "FileDescription", "KenshiCoop - Kenshi co-op multiplayer mod (Ogre plugin)"
            VALUE "FileVersion", KC_VER_STR
            VALUE "InternalName", "KenshiCoop"
            VALUE "LegalCopyright", "Open source: https://github.com/LRaverdy/KenshiCoop"
            VALUE "OriginalFilename", "KenshiCoop.dll"
            VALUE "ProductName", "KenshiCoop"
            VALUE "ProductVersion", KC_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40c, 1200
    END
END
